# Database (Neon, Supabase, Railway, or any Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/iptvlinux?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email (Resend) - used for verification / password reset emails (Phase 3)
RESEND_API_KEY=""
EMAIL_FROM="IPTVLinux <no-reply@iptvlinux.com>"

# Public site config
# IMPORTANT: set this to the real production domain before deploying.
# Used for canonical URLs, sitemap.xml, robots.txt, Open Graph, JSON-LD, and
# llms.txt. Falls back to a placeholder (never localhost) in production if
# left unset, but you should always set the real domain explicitly here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="34603171403"
